{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thesis-monitor-prototype",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "thesis-monitor-prototype",
      // Replace with the ID of your own Cloudflare D1 database before deployment.
      "database_id": "02cc48e1-755f-402e-abab-bb5e51887435",
      "migrations_dir": "drizzle"
    }
  ]
}
